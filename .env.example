# ============================================
# INFRAESTRUCTURA SGD - Variables de Entorno
# Copia este archivo a .env y rellena con tus valores reales
# ============================================

# --- Dominio ---
DOMAIN=tudominio.com

# --- Paths a los repos (relativos a sgd-infra/) ---
LARAVEL_PATH=../SDG-Back-api
OSAI_PATH=../OSAI
FRONTEND_DIST_PATH=../SGD-Front/dist/spa
OSAI_CREDENTIALS_PATH=../OSAI/credentials

# --- PostgreSQL 17 + pgvector ---
# Superusuario de Postgres: respaldos (backup.sh) y administración. La app NO lo usa.
POSTGRES_USER=sgd
# OBLIGATORIA: sin ella docker compose no arranca. Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=sgd

# --- Base de datos de la app (DB_*) ---
# La app se conecta con el rol sgd_app (sin superusuario). En una instalación nueva lo crea Postgres
# la primera vez que arranca con el volumen vacío (docs/PRODUCTION.md, sección 6.0).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sgd
DB_USERNAME=sgd_app
# OBLIGATORIA: contraseña del rol sgd_app (distinta de POSTGRES_PASSWORD). Generar con: openssl rand -hex 24
DB_PASSWORD=
# Tamaño de la base (GB) a partir del cual healthcheck.sh avisa
DB_SIZE_ALERT_GB=20

# --- Redis ---
# OBLIGATORIA (SGD-100): sin ella docker compose no arranca. Generar con: openssl rand -hex 20
REDIS_PASSWORD=
# Política de desalojo (SGD-109). volatile-lru = solo desaloja claves CON TTL
# (cache en DB 1); las colas (DB 0, sin TTL) NUNCA se desalojan → no se pierden
# jobs en silencio. No usar allkeys-lru (desaloja colas) ni noeviction (al
# llenarse rompe TODA escritura de cache/sesiones).
REDIS_MAXMEMORY_POLICY=volatile-lru
# Límite lógico de datos en Redis (debe ser < MEM_LIMIT_REDIS, por defecto 512m).
REDIS_MAXMEMORY=256mb

# --- Laravel APP_KEY ---
# Generar con: php artisan key:generate --show
APP_KEY=base64:coloca_aqui_tu_app_key_generada

# --- Token compartido OSAI <-> Laravel ---
# Debe coincidir con API_KEY_TOKEN de OSAI/.env
# Generar con: openssl rand -hex 32
OSAI_API_TOKEN=coloca_aqui_un_token_secreto_compartido

# --- Reverb (WebSocket) ---
# Generar con: openssl rand -hex 16
REVERB_APP_ID=coloca_aqui_reverb_app_id
REVERB_APP_KEY=coloca_aqui_reverb_app_key
REVERB_APP_SECRET=coloca_aqui_reverb_app_secret

# --- Backblaze B2 (almacenamiento de archivos) ---
B2_KEY_ID=tu_b2_key_id_aqui
B2_APPLICATION_KEY=tu_b2_application_key_aqui
B2_BUCKET=sgd-mr7
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_NAME=sgd-mr7

# --- Passport ---
PASSPORT_CLIENT_ID=2
PASSPORT_CLIENT_SECRET=coloca_aqui_passport_client_secret

# --- Mail (SMTP Resend) ---
# MAIL_USERNAME/MAIL_PASSWORD: la API key de Resend (re_...) va en el .env real del VPS, nunca en git.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=coloca_aqui_api_key_resend
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@aviliontech.com
MAIL_FROM_NAME=SGD

# --- IA: Proveedores (OSAI) ---
AI_SELECTOR=DEEPSEEK
AI_SELECTOR_EMERGENCY=GEMINI
AI_SELECTOR_VISION=GEMINI

# --- IA: Modelos ---
MODEL_GEMINI=gemini-2.5-flash
MODEL_DEEPSEEK=deepseek-chat
MODEL_COHERE=command-r-plus
MODEL_OPENAI=gpt-4o
AI_MODEL_VISION_FALLBACK=qwen/qwen-vl-plus:free

# --- IA: API Keys ---
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
# Claude (API de Anthropic). Modelo por defecto: claude-haiku-5-5 (el más barato).
ANTHROPIC_API_KEY=
MODEL_CLAUDE=claude-haiku-5-5
# Orden de proveedores de IA (el primero es el principal; los demás, respaldo). Ej.: claude,deepseek,gemini
TEXT_CHAIN=claude,deepseek,gemini
VISION_CHAIN=claude,deepseek,gemini
CO_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- LangSmith (tracing opcional) ---
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=Osai
LANGSMITH_API_KEY=

# --- Webhook secret (opcional) ---
WEBHOOK_SECRET=

# --- SSRF OSAI: sufijos de host permitidos para descarga de archivos (coma) ---
# El file_url que Laravel envía a OSAI siempre apunta al object store.
# Cambiar si se migra a S3 de AWS o al object store de Contabo.
ALLOWED_DOWNLOAD_HOSTS=backblazeb2.com

# --- Frontend SECRET_KEY (para encriptar tokens en localStorage) ---
# Generar con: openssl rand -hex 32
SECRET_KEY=coloca_aqui_un_secreto_de_32_bytes_hex

# --- Límites de memoria por servicio (SGD-098) ---
# Presupuestados para 8 GB de RAM. Si el VPS cambia de tamaño, ajustar
# según la matriz de sgd-infra/docs/ESCALABILIDAD-Y-RENDIMIENTO.md.
# La suma NO debe superar la RAM física (swap es red de seguridad, no sustituto).
MEM_LIMIT_POSTGRES=1g
MEM_LIMIT_APP=1536m
MEM_LIMIT_WORKER=512m
# SGD-105: hijos de PHP-FPM. Medido: ~65 MB en reposo por hijo; con margen para peticiones pesadas
# (~100 MB) caben 12 en MEM_LIMIT_APP=1536m. Recalcular si cambia MEM_LIMIT_APP: (límite × 0.8) / 100 MB.
PHP_FPM_MAX_CHILDREN=12
PHP_FPM_START_SERVERS=4
PHP_FPM_MIN_SPARE_SERVERS=2
PHP_FPM_MAX_SPARE_SERVERS=8
# Workers IA separados por ventanilla: pqrsd-ai = portal público, filing-ai = ventanilla interna
WORKER_PQRSD_REPLICAS=1
WORKER_FILING_REPLICAS=1
# Chat IA (cola chat-ai, worker-chat): interactivo, con su propio worker y memoria
WORKER_CHAT_REPLICAS=1
MEM_LIMIT_CHAT=512m
MEM_LIMIT_REDIS=512m
MEM_LIMIT_REVERB=384m
MEM_LIMIT_OSAI=1536m
MEM_LIMIT_NGINX=256m
MEM_LIMIT_POWERSYNC=1500m
# Memoria de Node dentro de PowerSync (MB): menor que MEM_LIMIT_POWERSYNC.
POWERSYNC_NODE_HEAP_MB=1024

# --- Backups ---
BACKUP_DIR=/home/deploy/backups

# --- Backups offsite (restic → object storage S3-compatible) ---
# Backend intercambiable: Backblaze B2, Contabo Object Storage, AWS S3, etc.
# Solo cambiar RESTIC_REPOSITORY y las credenciales AWS_* según el proveedor.
# restic usa el protocolo S3; las variables AWS_* son genéricas, no implican AWS.
RESTIC_REPOSITORY=s3:https://s3.us-east-005.backblazeb2.com/nombre-del-bucket
RESTIC_PASSWORD=contraseña-irrecuperable-custodiar-en-2-lugares
AWS_ACCESS_KEY_ID=key-id-restringida-al-bucket
AWS_SECRET_ACCESS_KEY=application-key-del-proveedor

# --- Alertas por Telegram (healthcheck.sh y backup.sh, SGD-096) ---
# Bot propio por instancia (crear con @BotFather). Sin estas variables no se envían alertas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firma electrónica del sistema para el índice electrónico (openssl rand -hex 32). No cambiarla: invalida la verificación de índices firmados.
ARCHIVE_INDEX_SIGNING_KEY=
ARCHIVE_INDEX_SIGNING_KEY_ID=sgd-2026-01

# --- Portal ciudadano ---
# Ofrecer el portal a los buscadores (Google, Bing). Solo `true` lo enciende: deploy-front.sh escribe entonces un
# robots.txt que permite las páginas informativas y un sitemap.xml. Con cualquier otro valor, robots.txt bloquea todo.
# Déjelo en false en instalaciones de prueba o demostración. Tras cambiarlo: bash scripts/deploy-front.sh
PORTAL_INDEXABLE=false
# Dominios que pueden llamar a la API desde el navegador, separados por comas (https://a.gov.co,https://b.gov.co).
# Se suman al dominio del portal (DOMAIN), que siempre está permitido. Vacío es lo normal. Ejemplo de uso: un
# front de desarrollo contra esta API (http://localhost:3000). Tras cambiarlo: up -d --no-deps app y deploy-laravel.sh
CORS_ALLOWED_ORIGINS=

# --- Trabajo sin conexión (PowerSync) ---
# Guía: docs/PRODUCTION.md › PowerSync. Sin POWERSYNC_URL la app no guarda nada en los equipos.
# Dirección pública (la de los equipos): https://DOMINIO/powersync
POWERSYNC_URL=
# Contraseñas de los roles de PowerSync en Postgres (openssl rand -hex 24). Las aplica powersync/preparar.sh.
POWERSYNC_REP_PASSWORD=
POWERSYNC_STORAGE_PASSWORD=
# Token de administración de la API de PowerSync (openssl rand -hex 24). No se expone por nginx.
POWERSYNC_ADMIN_TOKEN=
# Mitad de servidor de la llave de la base del escritorio (openssl rand -hex 32). Vacía = derivada de APP_KEY.
# Cambiarla deja ilegibles las bases de los equipos: el programa las borra y descarga todo de nuevo.
SYNC_DEVICE_SECRET=
# WAL que Postgres guarda si PowerSync se cae; al llegar, el slot se invalida y PowerSync copia todo de nuevo.
PG_MAX_SLOT_WAL=2GB
# Retraso de replicación que el healthcheck tolera (MB).
PS_MAX_LAG_MB=256
# Para que entre la app de escritorio, agregue su origen a CORS_ALLOWED_ORIGINS: http://tauri.localhost
